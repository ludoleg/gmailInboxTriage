# =============================================================================
# Gmail Inbox Triage Service — GCP Serverless Configuration
# Copy to .env for local runs; on Cloud Run Jobs, secrets are injected via
# Secret Manager (GEMINI_API_KEY, GMAIL_TOKEN_JSON, SLACK_WEBHOOK_URL).
# =============================================================================

# --- Timezone (California / Pacific Time) ---
TIMEZONE=America/Los_Angeles

# --- GCP Project & GenAI Backend ---
GCP_PROJECT_ID=gmail-inbox-triage-515705
# Set USE_VERTEXAI=true to use keyless Cloud Run Service Account IAM via Vertex AI.
# Leave USE_VERTEXAI=false to use GEMINI_API_KEY (from Google AI Studio / Secret Manager).
USE_VERTEXAI=false
VERTEX_LOCATION=global
GEMINI_API_KEY=

# --- 3-Tier Strength-Matched Model Funnel ---
MODEL_STAGE1_FAST=gemini-3.5-flash-lite
MODEL_STAGE2_WORKHORSE=gemini-4-carbon
MODEL_STAGE3_REASONING=gemini-4-neon
MAX_CONCURRENCY=6
DEEP_REVIEW_CONFIDENCE_THRESHOLD=0.70
MAX_DEEP_REVIEWS_PER_RUN=5

# --- State Persistence (firestore on Cloud Run, sqlite for local dev) ---
STATE_BACKEND=firestore
FIRESTORE_DATABASE=(default)
STATE_DB_PATH=/tmp/gmail-inbox-triage-state.db

# --- Gmail Read-Only OAuth ---
# On Cloud Run, GMAIL_TOKEN_JSON is injected from Secret Manager.
# Locally, triage auth saves to GMAIL_TOKEN_PATH.
GMAIL_TOKEN_JSON=
GMAIL_CREDENTIALS_PATH=/home/ludo/gmailInboxTriage/credentials.json
GMAIL_TOKEN_PATH=/home/ludo/.local/share/gmail-inbox-triage/token.json
GMAIL_QUERY_BASE=in:inbox is:unread
GMAIL_MAX_THREADS=60
DEFAULT_LOOKBACK_HOURS=24

# --- Slack Incoming Webhook ---
SLACK_WEBHOOK_URL=
# Optional Slack user/group mention on urgent items, e.g. <@U01234567>
SLACK_MENTION_ON_URGENT=
