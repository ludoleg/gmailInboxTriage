# =============================================================================
# Gmail Inbox Triage Service Configuration
# Copy to .env and fill in your credentials.
# =============================================================================

# --- Timezone (California / Pacific Time) ---
TIMEZONE=America/Los_Angeles

# --- Primary Local Engine: Inkling-2-Mini (sm_61 CUDA server via inkling-ctl) ---
INKLING_ENABLED=true
INKLING_BASE_URL=http://127.0.0.1:8001
MODEL_INKLING=inkling-2-mini
INKLING_CTL_PATH=/home/ludo/.local/bin/inkling-ctl
INKLING_CONTEXT_LIMIT=32768
INKLING_OVERFLOW_CHARS=84000
# restore = return inkling-server.service to its exact pre-run state
# keep_inkling = leave inkling-server.service running after triage
# idle = stop inkling-server.service and unload Ollama models after triage
GPU_RESTORE_POLICY=restore

# --- Conditional Multimodal & Fallback Engine: Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_MULTIMODAL=gemma4:12b
MODEL_FALLBACK_TRIAGE=gemma4:e2b
MODEL_FALLBACK_CODER=qwen2.5-coder:3b
MODEL_FALLBACK_SYNTHESIS=bonsai-2:27b

# --- Selective Cloud Escalation: Google Gemini 4 (via google-genai) ---
GEMINI_API_KEY=
MODEL_CLOUD_FAST=gemini-4-carbon
MODEL_CLOUD_DEEP=gemini-4-neon
CLOUD_ESCALATION_ENABLED=true
CLOUD_CONFIDENCE_THRESHOLD=0.70
MAX_CLOUD_ESCALATIONS_PER_RUN=5
# Comma-separated domains that must NEVER leave localhost
CLOUD_DENYLIST_DOMAINS=

# --- Gmail Read-Only OAuth ---
GMAIL_CREDENTIALS_PATH=/home/ludo/gmailInboxTriage/credentials.json
GMAIL_TOKEN_PATH=/home/ludo/.local/share/gmail-inbox-triage/token.json
GMAIL_QUERY_BASE=in:inbox is:unread
GMAIL_MAX_THREADS=60
DEFAULT_LOOKBACK_HOURS=24

# --- Slack Incoming Webhook ---
SLACK_WEBHOOK_URL=
# Optional Slack user/group mention on urgent items, e.g. <@U01234567>
SLACK_MENTION_ON_URGENT=

# --- Local Persistence ---
STATE_DB_PATH=/home/ludo/.local/share/gmail-inbox-triage/state.db
