# =============================================================================
# Gmail Inbox Triage Service — GCP Serverless Configuration (Phase 2)
# Copy to .env for local runs; on Cloud Run Jobs/Services, secrets are injected
# via Secret Manager.
# =============================================================================

# --- Timezone (California / Pacific Time) ---
TIMEZONE=America/Los_Angeles

# --- GCP Project, Region & GenAI Backend ---
GCP_PROJECT_ID=gmail-inbox-triage-515705
GCP_REGION=us-west1
# Set USE_VERTEXAI=true to use keyless Cloud Run Service Account IAM via Vertex AI.
USE_VERTEXAI=false
VERTEX_LOCATION=global
GEMINI_API_KEY=

# --- Cloud Run & Cloud Tasks (Phase 2 Interactive Bot) ---
CLOUD_RUN_JOB_NAME=gmail-inbox-triage
CLOUD_RUN_SERVICE_URL=
CLOUD_TASKS_QUEUE=triage-actions
INTERNAL_TASK_SECRET=

# --- 3-Tier Strength-Matched Model Funnel ---
MODEL_STAGE1_FAST=gemini-3.5-flash-lite
MODEL_STAGE2_WORKHORSE=gemini-4-carbon
MODEL_STAGE3_REASONING=gemini-4-neon
MAX_CONCURRENCY=6
DEEP_REVIEW_CONFIDENCE_THRESHOLD=0.70
MAX_DEEP_REVIEWS_PER_RUN=5

# --- State Persistence (firestore on Cloud Run, sqlite for local dev) ---
STATE_BACKEND=firestore
FIRESTORE_DATABASE=(default)
STATE_DB_PATH=/tmp/gmail-inbox-triage-state.db

# --- Google Workspace OAuth (gmail.modify + calendar.events + tasks) ---
GMAIL_TOKEN_JSON=
GMAIL_CREDENTIALS_PATH=/home/ludo/projects/gmailInboxTriage/credentials.json
GMAIL_TOKEN_PATH=/home/ludo/.local/share/gmail-inbox-triage/token.json
GMAIL_QUERY_BASE=in:inbox is:unread
GMAIL_MAX_THREADS=60
DEFAULT_LOOKBACK_HOURS=24

# --- Slack Bot (Interactive Phase 2 — preferred) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
# Optional comma-separated Slack user IDs allowed to click buttons or run /triage
SLACK_ALLOWED_USER_IDS=

# --- Slack Incoming Webhook (Optional fallback when SLACK_BOT_TOKEN is unset) ---
SLACK_WEBHOOK_URL=
SLACK_MENTION_ON_URGENT=
